NEXTAUTH_SECRET=super_safe_secret
AUTH_TRUST_HOST=true
NODE_ENV=production|development
PORT=3000
# Base URL of the Pythia 2.0 backend API (pythia2Client in src/lib/api-client.ts) — no trailing slash
NEXT_PUBLIC_PYTHIA_2_API_URL=https://pythia-be.inheritxdev.in
# Virtual-hosted-style bucket URL used to build viewable src for unknown-identity photos: `${base}/${s3_key}`
NEXT_PUBLIC_S3_ASSET_BASE_URL=https://your-bucket.s3.your-region.amazonaws.com
